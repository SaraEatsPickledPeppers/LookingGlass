{
  "target": "debug_menu_overlay",
  "operations": [
    {
      "op": "AddWidget",
      "parent": "root",
      "widget": {
        "id": "debug_menu_window",
        "widget_type": "Window",
        "properties": {
          "title": "Debug Menu",
          "width": 600,
          "height": 500,
          "closable": true,
          "resizable": true
        },
        "children": [
          {
            "id": "debug_tabs",
            "widget_type": "TabContainer",
            "properties": {},
            "children": [
              {
                "id": "level_select_tab",
                "widget_type": "Tab",
                "properties": {
                  "label": "Level Select"
                },
                "children": [
                  {
                    "id": "level_list",
                    "widget_type": "ListView",
                    "properties": {
                      "items": [
                        "visit00 - Intro",
                        "visit01 - Village of the Doomed",
                        "visit02 - Fortress of Doors",
                        "visit03 - Vale of Tears",
                        "visit04 - Cave of the Oracle",
                        "visit05 - Pool of Tears",
                        "visit06 - Looking Glass Land",
                        "visit07 - Behind the Looking Glass",
                        "visit08 - Jabberwock's Lair",
                        "visit09 - Palace of the Red Queen",
                        "visit10 - Queensland",
                        "visit11 - Kingdom of the Red Queen",
                        "visit12 - Chessboard",
                        "visit13 - Final Battle"
                      ],
                      "on_select": "warp_to_level"
                    },
                    "children": []
                  },
                  {
                    "id": "warp_button",
                    "widget_type": "Button",
                    "properties": {
                      "label": "Warp to Selected Level",
                      "action": "warp_to_level"
                    },
                    "children": []
                  }
                ]
              },
              {
                "id": "cheats_tab",
                "widget_type": "Tab",
                "properties": {
                  "label": "Cheats"
                },
                "children": [
                  {
                    "id": "noclip_toggle",
                    "widget_type": "Checkbox",
                    "properties": {
                      "label": "Noclip Mode",
                      "config_key": "debug-menu.enable_noclip",
                      "action": "toggle_noclip"
                    },
                    "children": []
                  },
                  {
                    "id": "god_mode_toggle",
                    "widget_type": "Checkbox",
                    "properties": {
                      "label": "God Mode",
                      "config_key": "debug-menu.enable_god_mode",
                      "action": "toggle_god_mode"
                    },
                    "children": []
                  },
                  {
                    "id": "fly_mode_toggle",
                    "widget_type": "Checkbox",
                    "properties": {
                      "label": "Fly Mode",
                      "config_key": "debug-menu.enable_fly",
                      "action": "toggle_fly"
                    },
                    "children": []
                  },
                  {
                    "id": "infinite_ammo_toggle",
                    "widget_type": "Checkbox",
                    "properties": {
                      "label": "Infinite Ammo",
                      "action": "toggle_infinite_ammo"
                    },
                    "children": []
                  },
                  {
                    "id": "one_hit_kill_toggle",
                    "widget_type": "Checkbox",
                    "properties": {
                      "label": "One Hit Kill",
                      "action": "toggle_one_hit_kill"
                    },
                    "children": []
                  }
                ]
              },
              {
                "id": "spawn_tab",
                "widget_type": "Tab",
                "properties": {
                  "label": "Spawn Items"
                },
                "children": [
                  {
                    "id": "spawn_category",
                    "widget_type": "ComboBox",
                    "properties": {
                      "label": "Category",
                      "items": ["Weapons", "Health", "Mana", "Keys", "Collectibles", "Enemies"],
                      "on_change": "filter_spawn_items"
                    },
                    "children": []
                  },
                  {
                    "id": "spawn_item_list",
                    "widget_type": "ListView",
                    "properties": {
                      "items": [
                        "Vorpal Blade",
                        "Playing Cards",
                        "Croquet Mallet",
                        "Jacks",
                        "Ice Wand",
                        "Demon Dice",
                        "Health Vial (Small)",
                        "Health Vial (Large)",
                        "Meta-Essence",
                        "Silver Key",
                        "Gold Key",
                        "Memory Fragment"
                      ],
                      "on_select": "spawn_selected_item"
                    },
                    "children": []
                  },
                  {
                    "id": "spawn_button",
                    "widget_type": "Button",
                    "properties": {
                      "label": "Spawn at Player",
                      "action": "spawn_selected_item"
                    },
                    "children": []
                  }
                ]
              },
              {
                "id": "tools_tab",
                "widget_type": "Tab",
                "properties": {
                  "label": "Tools"
                },
                "children": [
                  {
                    "id": "show_fps_toggle",
                    "widget_type": "Checkbox",
                    "properties": {
                      "label": "Show FPS",
                      "action": "toggle_fps"
                    },
                    "children": []
                  },
                  {
                    "id": "show_coords_toggle",
                    "widget_type": "Checkbox",
                    "properties": {
                      "label": "Show Coordinates",
                      "action": "toggle_coords"
                    },
                    "children": []
                  },
                  {
                    "id": "show_hitboxes_toggle",
                    "widget_type": "Checkbox",
                    "properties": {
                      "label": "Show Hitboxes",
                      "action": "toggle_hitboxes"
                    },
                    "children": []
                  },
                  {
                    "id": "show_navmesh_toggle",
                    "widget_type": "Checkbox",
                    "properties": {
                      "label": "Show NavMesh",
                      "action": "toggle_navmesh"
                    },
                    "children": []
                  },
                  {
                    "id": "slow_motion_slider",
                    "widget_type": "Slider",
                    "properties": {
                      "label": "Time Scale",
                      "min": 0.1,
                      "max": 2.0,
                      "step": 0.1,
                      "action": "set_time_scale"
                    },
                    "children": []
                  },
                  {
                    "id": "teleport_button",
                    "widget_type": "Button",
                    "properties": {
                      "label": "Teleport to Cursor",
                      "action": "teleport_to_cursor"
                    },
                    "children": []
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  ]
}